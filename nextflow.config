manifest {
    name = 'DRIP-seq STAR Protocol'
    description = 'DRIP-seq STAR Protocol: A Nextflow pipeline for processing DRIP-seq'
    homePage = 'https://github.com/MCrossleyLab/DRIP-seq_STAR_Protocol'
    nextflowVersion = '>=25.10.2'
    contributors = [
        [   name       : 'Hassan Massalha',
            orcid      : '0000-0002-9923-6878',
            affiliation: 'CRUK CI'
        ]
    ]
    organization = 'Cancer Research UK (CRUK) Cambridge Institute (CI)'
    version = '1.0.0'
}

params {
    samplesheet  = "${projectDir}/samplesheet.csv"
    genome_path  = "${projectDir}/Genomics/indexes"

    outdir_path  = "$projectDir"
    outdir_name  = "results"
    outdir       = "${params.outdir_path}/${params.outdir_name}"
    
    bowtie2_index_dir       = params.genome_path
    bowtie2_extra_params    = '--no-unal --no-mixed --no-discordant'
    bowtie2_index_suffix    = ""                                        // Optional: suffix to add, if you name indexes like hg38_mm10_spike
    species_list            = []                                        // Optional: suffix to add, if you name indexes like hg38_mm10_spike
}

workDir = params.outdir_path+ '/.work'

profiles {
    local {
        process {
            executor = 'local'
            conda = "$projectDir/envs/environment_1.yml"
        }
    }

    slurmc {
        process {
            executor = 'slurm'
            cpus = '8'
            memory = '4G'
            time = '48h'
            queue = 'epyc'
            conda = "$projectDir/envs/environment_1.yml"
            withName: 'BOWTIE2_ALIGN' { 
                cpus = '20'
                memory = 16.GB
                time = '12h'
            }
            // markdup_bams
            withName: 'SAMTOOLS_COLLATE|SAMTOOLS_FIXMATE|SAMTOOLS_SORT|SAMTOOLS_MARKDUP_INDEX' {
                errorStrategy = 'retry'
                maxRetries    = 3
                memory = {
                    def base = 10.GB
                    def m = base * (2 ** (task.attempt - 1))
                    m > 16.GB ? 16.GB : m
                }
            }
            // deeptools
            withName: 'BAMCOVERAGE' {
                memory = 20.GB
                cpus = '20'
            }
            // macs2
            withName: 'MACS2_CALLPEAK' {
                conda = "$projectDir/envs/environment_2.yml"
                memory = 16.GB
            }
        }
    }

    conda { 
        enable_conda = true
    }
}

// reporting
report {
    enabled   = true
    file      = "${params.outdir}/nf_reports/execution_report.html"
    overwrite = true
}

timeline {
    enabled   = true
    file      = "${params.outdir}/nf_reports/timeline.html"
    overwrite = true
}